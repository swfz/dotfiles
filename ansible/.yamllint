---
extends: default

ignore: |
  docker-compose*.yml
  versions_vars.yml
  .venv/

rules:
  braces:
    max-spaces-inside: 1
    level: error
  brackets:
    max-spaces-inside: 1
    level: error
  indentation:
    spaces: 2
    indent-sequences: consistent
    level: error
  line-length: disable
  truthy: disable
  # ansible-lint が要求する設定(合わないと ansible-lint が WARNING を出す)
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
